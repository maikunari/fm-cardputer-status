# ~/.config/fm-cardputer-status/env  (chmod 600; never commit the real one)

# Firstmate home; the publisher only reads $FM_HOME/state/home-summary.json.
FM_HOME=@FM_HOME@

# host or host:port. Unset = this machine's primary LAN IPv4 on port 8765.
# Prefer the LAN address: not 0.0.0.0, not a VPN-only address.
#FMS_BIND=192.168.1.10:8765

# Shared secret; put the same value in firmware/fm_status_cfg.json "token".
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(16))'
FMS_TOKEN=

# "counts" keeps task titles off the LAN (labels become "2 working", "1 call").
#FMS_LABELS=full

# Seconds a blocked decision or failed crew must persist before it turns red.
#FMS_RED_DEBOUNCE=60

# Serve a fixture instead of the live summary (testing).
#FMS_SUMMARY_PATH=/path/to/home-summary.json
